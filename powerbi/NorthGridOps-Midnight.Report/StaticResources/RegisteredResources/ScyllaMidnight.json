    "smallLightLabel": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#404040"
    },
    "smallDataLabel": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#404040"
    }
