{
  "$schema": "https://powerbi.com/product/schema#reportTheme",
  "name": "sqlbi",
  "dataColors": [
    "#2DD4BF",
    "#60A5FA",
    "#FBBF24",
    "#FB7185",
    "#A78BFA",
    "#94A3B8",
    "#34D399",
    "#F472B6"
