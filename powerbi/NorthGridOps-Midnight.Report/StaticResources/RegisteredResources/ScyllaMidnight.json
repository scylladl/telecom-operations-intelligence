  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "wordWrap": false,
            "rectangleRoundedCurve": 8,
            "roundEdge": 8
          }
        ],
        "general": [
          {
            "responsive": false,
            "responsiveLegacy": false
          }
        ],
        "outline": [
          {
            "transparency": 0
          }
        ],
        "dataPoint": [
          {
            "Transparency": 85,
            "fillTransparency": 50,
            "borderColorMatchFill": true,
            "borderOutlineOnly": true,
            "borderShow": true,
            "borderSize": 2
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "gridlineStyle": "dotted",
            "concatenateLabels": false,
            "maxMarginFactor": 50,
            "labelColor": {
              "solid": {
                "color": "#AAB6C8"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#22304A"
              }
            },
            "gridlineStyle": "dotted",
            "gridlineThickness": 1,
            "sharedAxis": true,
            "logAxisScale": false,
            "titleFontFamily": "Segoe UI",
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "titleFontSize": 9,
            "switchAxisPosition": false,
            "bold": false,
            "titleBold": false,
            "italic": false,
            "titleItalic": false,
            "underline": false,
            "titleUnderline": false,
            "labelColor": {
              "solid": {
                "color": "#AAB6C8"
              }
            }
          }
        ],
        "y2Axis": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "alignment": "left",
            "titleWrap": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#C9D4E5"
              }
            },
            "bold": false,
            "italic": false,
            "underline": false
          }
        ],
        "subTitle": [
          {
            "show": true,
            "alignment": "left",
            "titleWrap": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10.5,
            "fontColor": {
              "solid": {
                "color": "#AAAAAA"
              }
            },
            "bold": false,
            "italic": false,
            "underline": false
          }
        ],
        "divider": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#F0F0F0"
              }
            },
            "ignorePadding": false,
            "style": "solid",
            "width": 1.5
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 10,
            "right": 10
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#131C2E"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "width": 1,
            "color": {
              "solid": {
                "color": "#22304A"
              }
            },
            "show": true,
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false,
            "preset": "Center",
            "angle": 0,
            "color": {
              "solid": {
                "color": "#DDDDDD"
              }
            },
            "position": "Outer",
            "shadowBlur": 5,
            "shadowDistance": 5,
            "transparency": 20
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "transparency": 0,
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#B3B0AD"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "transparency": 0,
            "foregroundColor": {
              "solid": {
                "color": "#404040"
              }
            },
            "border": true
          },
          {
            "$id": "Available",
            "transparency": 0,
            "foregroundColor": {
              "solid": {
                "color": "#404040"
              }
            },
            "border": true
          }
        ],
        "lineStyles": [
          {
            "areaShow": true,
            "areaMatchStrokeColor": true,
            "showMarker": true,
            "markerSize": 4,
            "markerShape": "circle",
            "strokeShow": true,
            "strokeWidth": 1.5,
            "lineStyle": "solid",
            "lineChartType": "smooth",
            "interpolationStep": "center"
