      "color": "#E6EDF7"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#E6EDF7"
    },
    "dataTitle": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#8EA0B8"
    },
    "boldLabel": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#E6EDF7"
    },
    "largeLabel": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#404040"
    },
    "largeLightLabel": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#404040"
    },
    "lightLabel": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#404040"
    },
    "semiboldLabel": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#404040"
