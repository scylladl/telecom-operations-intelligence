        "labels": [
          {
            "fontFamily": "Segoe UI",
            "detailFontFamily": "Segoe UI",
            "fontSize": 9.5,
            "detailFontSize": 9,
            "titleFontSize": 9.5,
            "leaderLines": true,
            "leaderLineTransparency": 50,
            "leaderLineWidth": 1,
            "show": true,
            "enableBackground": false,
            "enableDetailDataLabel": false,
            "detailContentType": "Custom",
            "enableTitleDataLabel": false,
            "titleContentType": "Custom",
            "enableValueDataLabel": true,
            "optimizeLabelDisplay": false,
            "labelOverflow": true,
            "labelPosition": "OutsideEnd",
            "labelContentLayout": "SingleLine",
            "showBlankAs": "--",
            "detailShowBlankAs": "--",
            "titleShowBlankAs": "Unassigned",
            "transparency": 0,
            "wordWrap": false,
            "bold": true,
            "detailBold": false,
            "titleBold": true,
            "italic": false,
            "detailItalic": false,
            "titleItalic": false,
            "underline": false,
            "detailUnderline": false,
            "titleUnderline": false,
            "color": {
              "solid": {
                "color": "#E6EDF7"
              }
            }
          }
        ],
        "markers": [
          {
            "borderColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "borderShow": true,
            "borderTransparency": 0,
            "borderWidth": 1,
            "rotation": 45,
            "transparency": 0
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#AAB6C8"
              }
            }
          }
        ]
