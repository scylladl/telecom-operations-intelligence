            "labelContentLayout": "SingleLine",
            "showBlankAs": "--",
            "detailShowBlankAs": "--",
            "titleShowBlankAs": "Unassigned",
            "transparency": 0,
            "wordWrap": false,
            "bold": true,
            "detailBold": false,
            "titleBold": true,
            "italic": false,
            "detailItalic": false,
            "titleItalic": false,
            "underline": false,
            "detailUnderline": false,
            "titleUnderline": false
