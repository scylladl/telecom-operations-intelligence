model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 1

queryGroup Facts

	annotation PBI_QueryGroupOrder = 2

queryGroup Support

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Server","Database","Date","Circuit","Priority","Root Cause","Action Type","Age Bucket","Incident","Backlog Snapshot","Chronic Snapshot","Improvement Action","KPI Parameter","Data Quality Check","Processing Status","Trend Month"]

ref table Date
ref table Circuit
ref table Priority
ref table 'Root Cause'
ref table 'Action Type'
ref table 'Age Bucket'
ref table Incident
ref table 'Backlog Snapshot'
ref table 'Chronic Snapshot'
ref table 'Improvement Action'
ref table 'KPI Parameter'
ref table 'Data Quality Check'
ref table 'Processing Status'
ref table 'Trend Month'
ref table _Measures
ref table 'Time Comparison'
ref table 'Trend Window'
