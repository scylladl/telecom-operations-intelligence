/// K6: one row per circuit that is chronic at the end of each day (rule in KPI Parameter).
table 'Chronic Snapshot'
	lineageTag: bf4abab7-bef8-5e4a-b5bf-62f281fb0889

	column 'Snapshot Date Key'
		dataType: int64
		isHidden
		lineageTag: 08b1899e-8ead-57a6-b028-bc2a21f82def
		summarizeBy: none
		sourceColumn: SnapshotDateKey

		annotation SummarizationSetBy = Explicit

	column 'Circuit Key'
