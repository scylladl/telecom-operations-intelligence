# Copy to .env (not committed) and adjust.
NORTHGRID_SQL_SERVER=localhost
NORTHGRID_SQL_DATABASE=NorthGridOps
NORTHGRID_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# yes only for a local server with a self-signed certificate
NORTHGRID_SQL_TRUST_SERVER_CERTIFICATE=yes
# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_COOKIE_KEY=
